rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{id} {

      // Anyone can submit the signup form (create only)
      allow create: if request.resource.data.keys().hasOnly(
          ['fullName','phone','email','gender','city','interest','message','campaign','marketingConsent','submittedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.submittedAt == request.time;

      // Only the single authorised admin account can read registrations.
      allow read: if request.auth != null
        && request.auth.token.email == 'lebogangraseona576@gmail.com';

      allow update, delete: if false;
    }
  }
}
